# Copy to .env for Docker Compose; fill in secrets before starting services.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
INTERNAL_GATEWAY_SECRET=

# Used by a locally running Next.js server; Compose uses http://backend:8080/api.
BACKEND_API_URL=http://localhost:8080/api

# Optional Compose override when reusing an existing PostgreSQL container.
# BACKEND_DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/media_java

# Configure at least one complete OAuth pair to enable sign-in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Provider credentials belong to the Java backend only.
TMDB_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
RAWG_API_KEY=

# Local Java defaults. Compose connects to its db service instead.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/media_app
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=localpassword123
